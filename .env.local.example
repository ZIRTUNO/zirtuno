# ZIRTUNO — environment variables (build-spec S0.4)
# Copy to .env.local and fill. The site is deployable WITHOUT these:
# Sanity falls back to seeded prototype projects; the contact form degrades
# to a clear error if Resend is unconfigured.

# --- Sanity (CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# --- Resend (transactional email for the contact form) ---
RESEND_API_KEY=
# Where contact submissions are delivered:
CONTACT_EMAIL_TO=zirtuno@gmail.com
# Verified sender (must be a domain verified in Resend; falls back to onboarding sandbox):
CONTACT_EMAIL_FROM=Zirtuno <onboarding@resend.dev>

# --- Secondary contact paths (S10.5 / footer) ---
# WhatsApp: +55 32 99164-1200
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/5532991641200
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/zirtuno/

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://zirtuno.com
