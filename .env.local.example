# ZIRTUNO — environment variables (build-spec S0.4)
# Copy to .env.local and fill. Portfolio surfaces fail closed to an honest
# empty state. Contact delivery is not production-ready until the explicit
# readiness gate below passes.

# --- Sanity (CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Local concept review only. This flag is ignored in production, where Sanity
# is the sole portfolio source. Every concept remains visibly labeled.
PORTFOLIO_DEMO_MODE=false

# --- Resend (transactional email for the contact form) ---
RESEND_API_KEY=
# Signing secret for the Resend webhook at /api/contact/webhook:
RESEND_WEBHOOK_SECRET=
# Required real inbox where submissions are delivered. There is no fallback:
CONTACT_EMAIL_TO=
# Required sender on a domain whose DNS status is verified in Resend. The
# resend.dev sandbox sender is rejected in production:
CONTACT_EMAIL_FROM=
# Set true in production only after the sender domain is verified and an
# end-to-end test has reached CONTACT_EMAIL_TO. `npm run verify:production`
# enforces this launch gate with the production environment injected.
CONTACT_DELIVERY_READY=false
# Set only after signed delivered/bounced events reach hosting logs and alerts:
CONTACT_WEBHOOK_READY=false
# Set only after the production firewall/rate-limit rule is active:
CONTACT_RATE_LIMIT_READY=false

# --- Secondary contact paths (S10.5 / footer) ---
# Optional during local development; required by the production gate. This
# public mailbox is shown in the UI and stays separate from the private
# delivery recipient above.
NEXT_PUBLIC_CONTACT_EMAIL=
# Add only owner-approved public URLs. Missing channels are omitted locally;
# both URLs are required by the production identity gate.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
# Shown as icons in the footer colophon alongside the two above. Unset means
# the icon does not render at all -- never a dead link.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
# Set only after the owner verifies every public channel above:
PUBLIC_IDENTITY_READY=false

# --- Legal documents (S11 / footer Legal column) ---
# The shipped Terms/Privacy/Cookie copy is an honest scaffold describing what
# this codebase actually does; it has NOT been through legal review. While this
# is false the pages carry a visible review notice and are served `noindex`, so
# a placeholder policy never becomes the indexed policy of record. Set true
# only after reviewed copy replaces it in lib/i18n/messages/{pt,en}.json.
LEGAL_COPY_APPROVED=false

# --- Privacy-conscious analytics and field Web Vitals ---
# Use the site/domain and script URL supplied by the approved Plausible setup.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://zirtuno.com

# --- Entry intro (S1.10) Rive layer ---
# OPTIONAL. Unset — the shipped default — means the Rive layer does not exist:
# no chunk, no request, and the opening sequence plays complete without it.
# Set this to the public path of an authored file (for example /brand/intro.riv)
# and the layer mounts and is SCRUBBED by the intro's master timeline.
# The file must expose artboard "Intro", state machine "Intro", and a number
# input "progress" (0-100) driving a 1-D blend state — see entry-intro-spec.md
# for the full authoring contract. An artboard that can move while `progress`
# is held still is a second clock and will tear when a visitor skips.
NEXT_PUBLIC_INTRO_RIVE=
