{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zirtuno",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  // nodejs_compat is required by the adapter: this site runs API routes, the
  // next-intl proxy and the Sanity server client, none of which survive on the
  // bare edge runtime. global_fetch_strictly_public keeps in-Worker fetches
  // going out through the public internet, which is what Next expects.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
